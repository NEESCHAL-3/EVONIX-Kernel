Subject: [PATCH] mtk: adpf: allocate temporary arrays by element size

kcalloc already multiplies its count and element-size arguments. Passing
count * sizeof(element) as the size allocates count squared elements while
the userspace copy still copies only count elements. Use the element size
for create-session, work-report and set-threads temporary buffers.

Keep validation, copied lengths, callbacks, allocation failure handling and
freeing unchanged. This targets the vendor perf_ioctl module.

diff --git a/drivers/misc/mediatek/performance/perf_ioctl/ioctl_powerhal.c b/drivers/misc/mediatek/performance/perf_ioctl/ioctl_powerhal.c
--- a/drivers/misc/mediatek/performance/perf_ioctl/ioctl_powerhal.c
+++ b/drivers/misc/mediatek/performance/perf_ioctl/ioctl_powerhal.c
@@ -96,7 +96,7 @@
 			}
 
 			threadIds = kcalloc(t_msgKM->threadIds_size,
-				t_msgKM->threadIds_size*sizeof(__s32),
+				sizeof(*threadIds),
 				GFP_KERNEL);
 
 			if(!threadIds) {
@@ -142,7 +142,7 @@
 			}
 
 			workDuration = kcalloc(t_msgKM->work_duration_size,
-				t_msgKM->work_duration_size*sizeof(struct _ADPF_WORK_DURATION),
+				sizeof(*workDuration),
 				GFP_KERNEL);
 
 			if(!workDuration) {
@@ -185,7 +185,7 @@
 			}
 
 			threadIds = kcalloc(t_msgKM->threadIds_size,
-				t_msgKM->threadIds_size*sizeof(__s32), GFP_KERNEL);
+				sizeof(*threadIds), GFP_KERNEL);
 
 			if(!threadIds) {
 				pr_debug("ADPF_SET_THREADS threadIds is NULL");
