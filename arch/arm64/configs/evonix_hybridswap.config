# CONFIG_ZRAM is not set
# CONFIG_ZSMALLOC is not set
CONFIG_EVONIX_OPLUS_HYBRIDSWAP=y
CONFIG_HYBRID_ZSMALLOC=y
CONFIG_HYBRIDSWAP_ZRAM=y
CONFIG_HYBRIDSWAP=y
CONFIG_HYBRIDSWAP_SWAPD=y
CONFIG_HYBRIDSWAP_CORE=y
# CONFIG_HYBRIDSWAP_ZRAM_WRITEBACK is not set
CONFIG_EVONIX_OPLUS_HYBRIDSWAP_BUILTIN=y
CONFIG_EVONIX_RODIN_ADAPTER_CLASS=y
