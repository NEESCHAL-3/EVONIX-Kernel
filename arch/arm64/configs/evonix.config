# EVONIX Kernel Configuration v3.0
# Base: android15-6.6-lts / Linux 6.6.139
# Device: Poco X7 Pro / rodin

# WiFi/BT vendor module compatibility
CONFIG_MODULE_ALLOW_BTF_MISMATCH=y
# CONFIG_MODULE_SIG_PROTECT is not set
# CONFIG_CFG80211 is not set

# EVONIX UFS I/O scheduler support
CONFIG_MQ_IOSCHED_KYBER=y

# EVONIX kernel release branding
CONFIG_LOCALVERSION=""
# CONFIG_LOCALVERSION_AUTO is not set

# EVONIX TCP BBRv3
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_CUBIC=y
CONFIG_TCP_CONG_BBR=y
# CONFIG_DEFAULT_CUBIC is not set
CONFIG_DEFAULT_BBR=y
CONFIG_DEFAULT_TCP_CONG="bbr"

# EVONIX BBRv3 pacing qdisc
CONFIG_NET_SCHED=y
CONFIG_NET_SCH_FQ=y
CONFIG_NET_SCH_DEFAULT=y
CONFIG_DEFAULT_FQ=y
# CONFIG_DEFAULT_PFIFO_FAST is not set

# EVONIX AutoFDO profile optimization
CONFIG_AUTOFDO_CLANG=y

# EVONIX KernelSU Next v3.3.0
CONFIG_KSU=y
# CONFIG_KSU_DEBUG is not set
# CONFIG_KSU_DISABLE_MANAGER is not set
# CONFIG_KSU_DISABLE_POLICY is not set

# KernelSU Next SUSFS v2.2.0
CONFIG_KSU_SUSFS=y
CONFIG_KSU_SUSFS_SUS_PATH=y
CONFIG_KSU_SUSFS_SUS_MOUNT=y
CONFIG_KSU_SUSFS_SUS_KSTAT=y
CONFIG_KSU_SUSFS_SPOOF_UNAME=y
# CONFIG_KSU_SUSFS_ENABLE_LOG is not set
CONFIG_KSU_SUSFS_HIDE_KSU_SUSFS_SYMBOLS=y
CONFIG_KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG=y
CONFIG_KSU_SUSFS_OPEN_REDIRECT=y
CONFIG_KSU_SUSFS_SUS_MAP=y

# EVONIX production full-enforcing SELinux
CONFIG_SECURITY_SELINUX=y
# CONFIG_SECURITY_SELINUX_DEVELOP is not set
# CONFIG_SECURITY_SELINUX_BOOTPARAM is not set

CONFIG_CRYPTO_HMAC=y
CONFIG_CRYPTO_SHA256=y
