config OPLUS_FEATURE_FRAME_BOOST
        bool "OPlus Frame Boost Core"
        depends on OPLUS_FEATURE_SCHED_ASSIST
        default n
        help
          Enable native OPlus Frame Boost core.
          CFBT and GEAS are intentionally disabled.

config EVONIX_OPLUS_FRAME_IOCTL
        bool "Oplus native FrameBoost control protocol"
        depends on OPLUS_FEATURE_FRAME_BOOST
        default n
        help
          Route Oplus frame-control ioctls to the native FrameBoost core.
          Requires userspace ABI and on-device validation before production.
