menu "OPlus drivers"

config OPLUS_FEATURE_SCHED_ASSIST
        bool "OPlus SchedAssist"
        default n
        help
          Enable native OPlus SchedAssist imported from the
          MT6899 Linux 6.6 OPlus kernel source.



config EVONIX_OPLUS_SA_COMMON_HOOKS
        bool "EVONIX common scheduler hook bridge"
        depends on OPLUS_FEATURE_SCHED_ASSIST
        default n
        help
          Register enqueue/dequeue vendor hooks directly from the
          common kernel when MediaTek scheduler.ko glue is not used.

config LOCKING_PROTECT
        bool "OPlus SchedAssist locking protection"
        depends on OPLUS_FEATURE_SCHED_ASSIST
        default n
        help
          Enable locking protection required by native
          MT6899 OPlus SchedAssist.


config OPLUS_FEATURE_OPROJECT
        bool "OPlus project/OCDT information"
        default n
        help
          Build the native OPlus MTK project information driver.
          On non-OPlus device trees EVONIX may provide a hardware-ID
          compatibility fallback.

endmenu
